{
  "name": "zy-innovators",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/generate-resources.js && ng serve",
    "build": "node scripts/generate-resources.js && ng build",
    "deploy": "node scripts/generate-resources.js && ng build --configuration production --base-href /ZYInnovators/ && rm -rf docs && cp -r dist/zy-innovators/browser docs && cp docs/index.html docs/404.html && rm -rf dist",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}